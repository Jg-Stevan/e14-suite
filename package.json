{
  "name": "e14-suite",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev:movil": "cd apps/digielect14 && bun run dev",
    "dev:panel": "cd apps/supervision-e14 && bun run dev",
    "verificar:movil": "cd apps/digielect14 && bun run verificar",
    "verificar:panel": "cd apps/supervision-e14 && bun run verificar",
    "test:motor": "bun test packages/scanner-core",
    "build:panel": "cd apps/supervision-e14 && bun run build"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
